---
import type { Content } from '../data/content';
import Doodle from './art/Doodle.astro';
interface Props { c: Content }
const { c } = Astro.props;
const t = c.tray;
---
<button type="button" class="tray-fab fixed bottom-5 end-5 z-40 flex items-center gap-3 rounded-full bg-ink py-2.5 pe-5 ps-3 text-milk shadow-[0_14px_30px_-14px_rgba(28,26,23,0.7)]" data-tray-open aria-haspopup="dialog" hidden>
  <span class="t-num grid h-9 w-9 place-items-center rounded-full bg-cognac font-bold" data-tray-count>0</span>
  <span class="flex flex-col items-start leading-tight">
    <span class="t-hand text-[1.1rem] text-milk/80">{t.title}</span>
    <span class="t-num text-[0.95rem] font-bold" data-tray-total-fab></span>
  </span>
</button>
<dialog class="tray-dialog m-0 ms-auto h-[100dvh] max-h-none w-full max-w-md bg-milk p-0 text-ink" data-tray aria-labelledby="tray-title">
  <div class="paper flex h-full flex-col">
    <div class="flex items-center justify-between border-b-[1.5px] border-ink px-6 py-5">
      <h2 id="tray-title" class="t-display text-4xl">{t.title}</h2>
      <button type="button" class="grid h-10 w-10 place-items-center rounded-full border-[1.5px] border-line" data-tray-close aria-label={t.close}>
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m1 1 10 10M11 1 1 11" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto px-6" data-lenis-prevent>
      <div class="hidden flex-col items-center gap-5 py-16 text-center" data-tray-empty>
        <Doodle name="cup" class="w-16 text-ink-soft" draw={false} />
        <p class="t-body text-ink-soft">{t.empty}</p>
      </div>
      <ul data-tray-list></ul>
    </div>
    <div class="border-t-[1.5px] border-ink px-6 py-5">
      <div class="flex items-baseline justify-between"><span class="t-meta text-ink-soft">{t.total}</span><span class="t-display t-num text-4xl" data-tray-total></span></div>
      <p class="mt-2 text-[0.82rem] leading-relaxed text-ink-soft">{t.note}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href="#" target="_blank" rel="noopener" class="btn btn-cognac btn-sm" data-tray-wa>{t.whatsapp}</a>
        <button type="button" class="btn btn-line btn-sm" data-tray-copy data-label={t.copy} data-done={t.copied}>{t.copy}</button>
        <button type="button" class="btn btn-sm ms-auto text-ink-soft hover:underline" data-tray-clear>{t.clear}</button>
      </div>
    </div>
  </div>
</dialog>
<style>
  .tray-fab { transition: transform 0.5s var(--ease-pour); }
  .tray-fab:hover { transform: translateY(-3px); }
  .tray-fab.bump { animation: bump 0.5s var(--ease-pour); }
  @keyframes bump { 40% { transform: scale(1.08); } }
  .tray-dialog::backdrop { background: rgb(28 26 23 / 0.35); backdrop-filter: blur(3px); }
  .tray-dialog[open] { animation: slideIn 0.55s var(--ease-pour); }
  @keyframes slideIn { from { transform: translateX(100%); } }
  :global([dir='rtl']) .tray-dialog[open] { animation-name: slideInRtl; }
  @keyframes slideInRtl { from { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .tray-dialog[open] { animation: none; } }
</style>
