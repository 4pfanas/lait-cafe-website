---
import type { Content } from '../data/content';
import SmartImage from './ui/SmartImage.astro';
interface Props { c: Content }
const { c } = Astro.props;
const k = c.catering;
---
<section id="catering" class="relative scroll-mt-16 bg-paper py-24 md:py-32" aria-labelledby="cat-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{k.eyebrow}</p>
        <h2 id="cat-title" class="t-display t-h2 mt-3" data-reveal>{k.title}</h2>
      </div>
      <div class="lg:col-span-5" data-reveal>
        <p class="t-body text-ink-soft">{k.sub}</p>
        <p class="t-meta mt-4 inline-flex items-center gap-2 rounded-full bg-milk px-4 py-2" data-cutoff><span class="h-2 w-2 rounded-full bg-cognac" aria-hidden="true"></span><span data-cutoff-text>{k.cutoff}</span></p>
      </div>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      <form class="lg:col-span-7" data-cater novalidate>
        <fieldset>
          <legend class="t-display text-[1.8rem]"><span class="t-hand me-2 text-cognac">1</span>{k.step1}</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {k.options.map((o) => (
              <label class="cater-opt group relative flex cursor-pointer items-start gap-4 rounded-[20px] border-[1.5px] border-line bg-milk p-4 transition-colors">
                <input type="checkbox" name="what" value={o.id} data-label={o.label} class="peer sr-only" />
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border-[1.5px] border-ink/40 peer-checked:border-ink peer-checked:bg-ink peer-focus-visible:outline-2 peer-focus-visible:outline-cognac" aria-hidden="true">
                  <svg width="11" height="9" viewBox="0 0 11 9" class="opacity-0 group-has-[:checked]:opacity-100"><path d="M1 4.5 4 7.5 10 1" fill="none" stroke="var(--color-milk)" stroke-width="1.8" /></svg>
                </span>
                <span><span class="block font-bold">{o.label}</span><span class="t-hand block text-[1.15rem] text-ink-soft">{o.note}</span></span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-10">
          <legend class="t-display text-[1.8rem]"><span class="t-hand me-2 text-cognac">2</span>{k.step2}</legend>
          <div class="mt-4 flex flex-wrap gap-2" role="radiogroup">
            {k.guests.map((g, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="guests" value={g} class="peer sr-only" checked={i === 1} />
                <span class="chip peer-checked:border-ink peer-checked:bg-ink peer-checked:text-milk peer-focus-visible:outline-2 peer-focus-visible:outline-cognac">{g} {k.guestsUnit}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          <label class="block">
            <span class="t-display text-[1.8rem]"><span class="t-hand me-2 text-cognac">3</span>{k.step3}</span>
            <input type="date" name="date" required class="mt-3 h-12 w-full rounded-full border-[1.5px] border-line bg-milk px-5 outline-none focus:border-ink" data-cater-date />
          </label>
          <label class="block">
            <span class="t-display text-[1.8rem]"><span class="t-hand me-2 text-cognac">4</span>{k.step4}</span>
            <input type="text" name="ribbon" maxlength="40" placeholder={k.ribbonPlaceholder} class="mt-3 h-12 w-full rounded-full border-[1.5px] border-line bg-milk px-5 outline-none focus:border-ink" data-cater-ribbon />
          </label>
          <label class="block sm:col-span-2">
            <span class="t-meta text-ink-soft">{k.name}</span>
            <input type="text" name="name" maxlength="60" autocomplete="name" class="mt-2 h-12 w-full rounded-full border-[1.5px] border-line bg-milk px-5 outline-none focus:border-ink" />
          </label>
        </div>
      </form>

      <aside class="lg:col-span-5" aria-live="polite">
        <div class="sticky top-28 rounded-[30px] bg-milk p-6 shadow-[0_30px_60px_-40px_rgba(28,26,23,0.45)] md:p-8">
          <p class="t-hand text-[1.6rem] text-cognac">{k.preview}</p>
          <div class="relative mx-auto mt-4 w-full max-w-[22rem]" data-box>
            <svg viewBox="0 0 320 250" class="w-full" aria-hidden="true">
              <defs>
                <path id="ribbon-path" d="M20 150 L300 150" />
              </defs>
              <!-- box -->
              <path d="M40 90 L280 90 L280 230 Q280 238 272 238 L48 238 Q40 238 40 230 Z" fill="#fff" stroke="var(--color-ink)" stroke-width="2" stroke-linejoin="round" />
              <path d="M30 72 L290 72 L290 92 L30 92 Z" fill="#fff" stroke="var(--color-ink)" stroke-width="2" stroke-linejoin="round" />
              <rect x="110" y="120" width="100" height="70" rx="8" fill="var(--color-paper)" stroke="var(--color-ink)" stroke-width="1.5" />
              <g class="box-items" data-box-items></g>
              <!-- ribbon -->
              <g class="ribbon" data-ribbon>
                <rect x="34" y="140" width="252" height="22" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="1.5" />
                <text x="160" y="155.5" text-anchor="middle" class="ribbon-text" data-ribbon-text>LAiT · LAiT · LAiT</text>
                <g class="bow" data-bow transform="translate(160 76)">
                  <path d="M0 0 C-30 -34 -64 -20 -52 -2 C-44 10 -18 6 0 0 Z" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="1.6" />
                  <path d="M0 0 C30 -34 64 -20 52 -2 C44 10 18 6 0 0 Z" fill="var(--color-milk)" stroke="var(--color-ink)" stroke-width="1.6" />
                  <path d="M-4 2 L-18 40 M4 2 L20 38" stroke="var(--color-ink)" stroke-width="1.6" fill="none" stroke-linecap="round" />
                  <circle r="7" fill="var(--color-cognac)" />
                </g>
              </g>
            </svg>
          </div>
          <ul class="mt-6 min-h-[3rem] space-y-1.5" data-box-list></ul>
          <p class="mt-2 text-[0.85rem] text-ink-soft" data-box-meta></p>
          <a href="#" target="_blank" rel="noopener" class="btn btn-cognac mt-6 w-full" data-cater-send aria-disabled="true">{k.send}</a>
          <p class="mt-3 text-center text-[0.8rem] text-ink-soft" data-cater-hint>{k.pick}</p>
          <p class="mt-1 text-center text-[0.8rem] text-ink-soft">{k.priceNote}</p>
        </div>
      </aside>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-3" data-reveal>
      {['cater-croissants', 'cater-sweets', 'cater-cake'].map((n, i) => (
        <div class="aspect-[4/3] overflow-hidden rounded-[24px]"><SmartImage name={n} alt="" sizes="(min-width: 640px) 30vw, 90vw" doodle={(['croissant', 'softserve', 'box'] as const)[i]} tone={i === 1 ? 'crema' : 'paper'} /></div>
      ))}
    </div>
  </div>
</section>
<style>
  .cater-opt:has(:checked) { border-color: var(--color-ink); background: #fff; }
  .cater-opt:hover { border-color: rgb(28 26 23 / 0.45); }
  .ribbon-text { font-family: var(--font-hand); font-size: 15px; fill: var(--color-cognac); letter-spacing: 0.02em; }
  .bow { transform-box: fill-box; }
  .bow.tie { animation: tie 0.8s var(--ease-pour); }
  @keyframes tie { 0% { scale: 0.4; rotate: -20deg; } 60% { scale: 1.12; rotate: 6deg; } 100% { scale: 1; rotate: 0deg; } }
  [data-cater-send][aria-disabled='true'] { opacity: 0.45; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .bow.tie { animation: none; } }
</style>
