---
import type { Content } from '../data/content';
import SmartImage from './ui/SmartImage.astro';
import Doodle from './art/Doodle.astro';
interface Props { c: Content }
const { c } = Astro.props;
const s = c.space, r = c.reviews;
---
<section class="relative py-24 md:py-32" aria-labelledby="space-title">
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{s.eyebrow}</p>
      <h2 id="space-title" class="t-display t-h2 mt-3" data-reveal>{s.title}</h2>
      <ul class="mt-10 space-y-6">
        {s.points.map((p) => (
          <li class="border-t border-line pt-5" data-reveal><h3 class="font-bold">{p.title}</h3><p class="mt-1 text-ink-soft">{p.text}</p></li>
        ))}
      </ul>
    </div>
    <div class="grid grid-cols-6 gap-4 lg:col-span-7">
      <div class="col-span-6 aspect-[16/10] overflow-hidden rounded-[28px] md:col-span-4" data-reveal><div class="h-full w-full" data-drift><SmartImage name="room-window" alt="" sizes="(min-width: 1024px) 40vw, 90vw" doodle="heart" /></div></div>
      <div class="col-span-3 aspect-[3/4] overflow-hidden rounded-[999px_999px_24px_24px] md:col-span-2" data-reveal><SmartImage name="room-cushion" alt="" sizes="20vw" doodle="cup" tone="crema" /></div>
      <div class="col-span-3 aspect-[3/4] overflow-hidden rounded-[24px] md:col-span-2" data-reveal><SmartImage name="room-latte" alt="" sizes="20vw" doodle="heart" tone="crema" /></div>
      <div class="col-span-6 aspect-[16/7] overflow-hidden rounded-[28px] md:col-span-4" data-reveal><SmartImage name="room-table" alt="" sizes="(min-width: 1024px) 40vw, 90vw" doodle="croissant" /></div>
    </div>
  </div>

  <div class="container-x mt-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{r.eyebrow}</p>
        <h2 class="t-display t-h2 mt-3" data-reveal>{r.title}</h2>
      </div>
      <Doodle name="sparkle" class="w-10 text-cognac" />
    </div>
    <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {r.items.map((q, i) => (
        <li class:list={['flex flex-col justify-between gap-8 rounded-[24px] border-[1.5px] p-6', i === 0 ? 'border-ink bg-ink text-milk' : 'border-line bg-white/50']} data-reveal>
          <p class="t-display text-[1.45rem] leading-snug">“{q}”</p>
          <p class="t-meta flex items-center justify-between opacity-75"><span aria-label="5 stars">★★★★★</span><span>{r.source}</span></p>
        </li>
      ))}
    </ul>
  </div>
</section>
