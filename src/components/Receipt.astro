---
// A thermal-printer slot; the receipt slides out as you scroll. Lines and prices come from the real menu.
import type { Lang } from '../data/site';
import { site } from '../data/site';
import type { Content } from '../data/content';
import { findItem, itemText } from '../lib/menuL10n';
import { num } from '../lib/format';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const r = c.fx.receipt;
const rows = ['pink-spicy-pasta', 'um-ali', 'v60', 'cheesecake', 'ocean-latte'].map((id) => { const it = findItem(id); return { name: itemText(it, lang).name, price: it.price }; });
const total = rows.reduce((a, b) => a + b.price, 0);
const msg = `${r.message}\n${rows.map((x) => `• ${x.name}`).join('\n')}`;
---
<section class="receipt relative overflow-hidden bg-ink pb-24 pt-24 text-milk md:pb-32 md:pt-32" aria-labelledby="receipt-title" data-receipt>
  <div class="container-x text-center">
    <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{r.eyebrow}</p>
    <h2 id="receipt-title" class="t-display t-h2 mt-3" data-reveal>{r.title}</h2>
    <p class="t-body mx-auto mt-4 max-w-md text-milk/70" data-reveal>{r.sub}</p>
    <div class="relative mx-auto mt-14 w-[min(88vw,22rem)]">
      <div class="relative z-10 h-5 rounded-full bg-espresso shadow-[0_0_0_1.5px_rgba(251,248,242,.25)]" aria-hidden="true"><div class="absolute inset-x-3 bottom-1 h-1.5 rounded-full bg-black/70"></div></div>
      <div class="-mt-1 overflow-hidden px-3 pb-6" data-receipt-clip>
        <div class="paper rcpt relative bg-milk px-6 pb-8 pt-7 text-start text-ink" data-receipt-paper dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          <p class="t-meta text-center tracking-widest">{r.head}</p>
          <hr class="my-4 border-t-[1.5px] border-dashed border-ink/40" />
          <ul class="grid gap-2 text-[0.95rem]">
            {rows.map((x) => <li class="flex justify-between gap-4"><span>{x.name}</span><span class="t-num">{num(x.price, lang)}</span></li>)}
          </ul>
          <hr class="my-4 border-t-[1.5px] border-dashed border-ink/40" />
          <p class="flex justify-between text-[1.1rem] font-bold"><span>{r.total}</span><span class="t-num">{c.menu.currency} {num(total, lang)}</span></p>
          <div class="barcode my-6 h-14" aria-hidden="true"></div>
          <p class="t-hand text-center text-[1.7rem] text-cognac">{r.thanks}</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href={site.orderUrl} target="_blank" rel="noopener" class="btn btn-ink justify-center"><span>{r.order}</span></a>
            <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(msg)}`} target="_blank" rel="noopener" class="btn btn-line justify-center"><span>{r.whatsapp}</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .barcode { background: repeating-linear-gradient(90deg, #1c1a17 0 2px, transparent 2px 5px, #1c1a17 5px 6px, transparent 6px 10px, #1c1a17 10px 13px, transparent 13px 15px); }
  .rcpt { clip-path: polygon(0 0,100% 0,100% calc(100% - 8px),96% 100%,92% calc(100% - 8px),88% 100%,84% calc(100% - 8px),80% 100%,76% calc(100% - 8px),72% 100%,68% calc(100% - 8px),64% 100%,60% calc(100% - 8px),56% 100%,52% calc(100% - 8px),48% 100%,44% calc(100% - 8px),40% 100%,36% calc(100% - 8px),32% 100%,28% calc(100% - 8px),24% 100%,20% calc(100% - 8px),16% 100%,12% calc(100% - 8px),8% 100%,4% calc(100% - 8px),0 100%); }
</style>
