---
import type { Content } from '../data/content';
import Doodle from './art/Doodle.astro';
interface Props { c: Content }
const { c } = Astro.props;
const a = c.ask;
---
<section id="ask" class="ask relative isolate scroll-mt-16 overflow-hidden bg-ink py-24 text-milk md:py-32" aria-labelledby="ask-title">
  <Doodle name="softserve" class="pointer-events-none absolute -bottom-6 end-[6%] -z-10 hidden w-56 text-milk/10 md:block" draw={false} />
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{a.eyebrow}</p>
      <h2 id="ask-title" class="t-display t-h2 mt-3" data-reveal>{a.title}</h2>
      <p class="t-body mt-6 max-w-md text-milk/75" data-reveal>{a.sub}</p>
    </div>
    <div class="lg:col-span-7">
      <form class="relative" data-ask-form role="search">
        <label for="ask-input" class="sr-only">{a.label}</label>
        <textarea id="ask-input" rows="2" maxlength="240" data-ask-input placeholder={a.placeholder}
          class="block w-full resize-none rounded-[26px] border-[1.5px] border-milk/25 bg-milk px-6 py-5 pe-28 text-[1.05rem] leading-relaxed text-ink outline-none placeholder:text-ink-soft/60 focus:border-cognac"></textarea>
        <button type="submit" class="btn btn-cognac absolute bottom-3 end-3">{a.submit}</button>
      </form>
      <ul class="mt-5 flex flex-wrap gap-2">
        {a.examples.map((ex) => <li><button type="button" class="rounded-full border-[1.5px] border-milk/25 px-4 py-2 text-[0.85rem] transition-colors hover:bg-milk hover:text-ink" data-ask-example>{ex}</button></li>)}
      </ul>
      <div class="mt-10 min-h-[17rem]" data-ask-out aria-live="polite"><p class="t-body text-milk/65">{a.idle}</p></div>
    </div>
  </div>
  <template data-ask-card>
    <li class="ask-card flex flex-col justify-between gap-6 rounded-[24px] bg-milk p-6 text-ink">
      <div>
        <p class="t-meta text-ink-soft" data-f="section"></p>
        <h3 class="t-display mt-2 text-[1.9rem] leading-tight" data-f="name"></h3>
        <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-soft" data-f="desc"></p>
      </div>
      <div>
        <p class="t-hand text-[1.2rem] text-cognac" data-f="why"></p>
        <div class="mt-3 flex items-center justify-between gap-3 border-t border-line pt-4">
          <span class="t-num font-bold" data-f="price"></span>
          <button type="button" class="tray-btn grid h-9 w-9 place-items-center rounded-full border-[1.5px] border-line" aria-pressed="false" data-tray-add="">
            <svg class="plus" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
        </div>
      </div>
    </li>
  </template>
</section>
<style>
  :global(.ask-heard) { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  :global(.ask-heard .pill) { border: 1.5px solid rgb(251 248 242 / 0.35); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.82rem; }
  :global(.ask-card) { opacity: 0; transform: translateY(16px); transition: opacity 0.6s var(--ease-pour), transform 0.7s var(--ease-pour); }
  :global(.ask-card.in) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { :global(.ask-card) { opacity: 1; transform: none; } }
</style>
