---
import type { Lang } from '../data/site';
import type { Content } from '../data/content';
import { chapters } from '../data/menu';
import { itemText, sectionTitle, chapterText } from '../lib/menuL10n';
import { num } from '../lib/format';
import Doodle from './art/Doodle.astro';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
const m = c.menu;
const count = (ch: (typeof chapters)[number]) => ch.sections.reduce((a, s) => a + s.items.length, 0);
---
<section id="menu" class="relative scroll-mt-16 border-t-[1.5px] border-ink bg-milk py-24 md:py-32" aria-labelledby="menu-title">
  <div class="container-x">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="t-hand text-[1.9rem] text-cognac" data-reveal>{m.eyebrow}</p>
        <h2 id="menu-title" class="t-display t-h2 mt-3" data-reveal>{m.title}</h2>
      </div>
      <p class="t-body text-ink-soft lg:col-span-4 lg:col-start-9" data-reveal>{m.sub}</p>
    </div>

    <!-- right now -->
    <div class="mt-12 rounded-[26px] border-[1.5px] border-line bg-paper p-5 md:p-6" data-reveal>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <p class="t-hand text-[1.7rem] text-cognac">{m.now}</p>
        <p class="t-meta text-ink-soft" data-now-line></p>
      </div>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-now-list></ul>
    </div>

    <div role="tablist" aria-label={m.eyebrow} class="mt-14 flex gap-2 overflow-x-auto pb-1">
      {chapters.map((ch, i) => (
        <button type="button" role="tab" id={`tab-${ch.id}`} aria-controls={`panel-${ch.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={ch.id}
          class="menu-tab shrink-0 rounded-full border-[1.5px] border-line px-5 py-3 text-start">
          <span class="t-display text-[1.6rem] leading-none">{chapterText(ch, lang).title}</span>
          <span class="t-meta ms-2 opacity-60">{num(count(ch), lang)}</span>
        </button>
      ))}
    </div>

    <div class="menu-toolbar sticky top-[72px] z-30 -mx-5 mt-4 border-b border-line bg-milk/95 px-5 py-3 backdrop-blur md:mx-0 md:rounded-2xl md:border md:px-4">
      <div class="flex flex-col gap-3 md:flex-row md:items-center">
        <label class="relative flex-1">
          <span class="sr-only">{m.searchLabel}</span>
          <svg class="pointer-events-none absolute start-4 top-1/2 -translate-y-1/2 text-ink-soft" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m11 11 4 4" stroke="currentColor" stroke-width="1.6" /></svg>
          <input type="search" data-menu-search placeholder={m.search} autocomplete="off" enterkeyhint="search"
            class="h-12 w-full rounded-full border-[1.5px] border-line bg-white/60 pe-4 ps-11 outline-none placeholder:text-ink-soft/60 focus:border-ink" />
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filters">
          {(['sig', 'V', 'hot', 'cold'] as const).map((f) => <button type="button" class="chip" aria-pressed="false" data-filter={f}>{m.filters[f]}</button>)}
        </div>
      </div>
    </div>

    {chapters.map((ch, i) => {
      const ct = chapterText(ch, lang);
      return (
        <div role="tabpanel" id={`panel-${ch.id}`} aria-labelledby={`tab-${ch.id}`} data-panel={ch.id} hidden={i !== 0} class="mt-10">
          <p class="t-hand text-[1.6rem] text-ink-soft">{ct.note}</p>
          <div class="mt-6 grid gap-x-16 gap-y-12 lg:grid-cols-2">
            {ch.sections.map((s) => (
              <div data-section class="break-inside-avoid">
                <h3 class="t-display flex items-baseline justify-between border-b-[1.5px] border-ink pb-3 text-[2rem]">{sectionTitle(s, lang)}<span class="t-meta text-ink-soft">{num(s.items.length, lang)}</span></h3>
                <ul>
                  {s.items.map((it) => {
                    const tx = itemText(it, lang);
                    return (
                      <li class="menu-item flex items-start gap-3 border-b border-line py-3.5" data-id={it.id}>
                        <div class="min-w-0 flex-1">
                          <p class="flex items-baseline gap-2">
                            <span class="item-name font-bold">{tx.name}</span>
                            {it.tags?.includes('sig') && <span class="t-hand text-[1.15rem] text-cognac">★</span>}
                            <span class="leader min-w-6 flex-1 translate-y-[-4px] border-b border-dotted border-ink/30" aria-hidden="true"></span>
                            <span class="t-num shrink-0 font-semibold"><span class="me-1 text-[0.7rem] font-medium text-ink-soft">{m.currency}</span>{num(it.price, lang)}</span>
                          </p>
                          {tx.desc && <p class="mt-1 text-[0.88rem] leading-relaxed text-ink-soft">{tx.desc}</p>}
                        </div>
                        <button type="button" class="tray-btn mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border-[1.5px] border-line transition-colors hover:border-ink" aria-pressed="false" data-tray-add={it.id} aria-label={`${m.add}: ${tx.name}`}>
                          <svg class="plus" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.6" /></svg>
                        </button>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
          <div class="menu-empty hidden flex-col items-center gap-4 py-16 text-center" data-menu-empty>
            <Doodle name="cup" class="w-16 text-ink-soft" draw={false} />
            <p class="t-body text-ink-soft">{m.empty}</p>
          </div>
        </div>
      );
    })}

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-ink-soft md:flex-row md:justify-between">
      <p class="t-meta">★ {m.filters.sig} · {m.allergy}</p>
      <p class="t-meta">{m.source}</p>
    </div>
  </div>
</section>
<style>
  .menu-tab { transition: background-color 0.35s, color 0.35s, border-color 0.35s; }
  .menu-tab:hover { border-color: var(--color-ink); }
  .menu-tab[aria-selected='true'] { background: var(--color-ink); color: var(--color-milk); border-color: var(--color-ink); }
  .menu-item.is-hit .item-name { background: linear-gradient(transparent 60%, rgb(176 90 38 / 0.22) 60%); }
  .menu-empty.is-shown { display: flex; }
  :global(.now-card) { transition: border-color 0.3s, transform 0.5s var(--ease-pour); }
  :global(.now-card:hover) { border-color: var(--color-ink); transform: translateY(-2px); }
</style>
