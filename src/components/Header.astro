---
import { site, pathFor, type Lang } from '../data/site';
import type { Content } from '../data/content';
import Logo from './art/Logo.astro';
interface Props { c: Content; lang: Lang }
const { c, lang } = Astro.props;
---
<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="container-x flex h-[72px] items-center justify-between gap-4">
    <a href={pathFor(lang)} aria-label={c.nav.home} class="text-[2.2rem] text-ink"><Logo /></a>
    <nav aria-label={c.nav.label} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {c.nav.links.map((l) => <li><a href={l.href} class="nav-link t-meta text-ink-soft hover:text-ink">{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href={pathFor(c.nav.switchLang)} lang={c.nav.switchLang} class="t-meta hidden px-3 text-ink-soft hover:text-ink sm:inline-block" data-lang-switch>{c.nav.switchLabel}</a>
      <a href={site.orderUrl} target="_blank" rel="noopener" class="btn btn-ink btn-sm">{c.nav.order}</a>
      <button type="button" class="grid h-[42px] w-[42px] place-items-center rounded-full border-[1.5px] border-line lg:hidden" data-nav-open aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
        <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="mobile-nav paper fixed inset-0 top-[72px] z-40 hidden bg-milk lg:hidden" data-mobile-nav>
    <nav aria-label={c.nav.label} class="container-x flex h-full flex-col justify-between py-10">
      <ul class="flex flex-col gap-5">
        {c.nav.links.map((l) => <li><a href={l.href} class="t-display text-5xl" data-nav-close>{l.label}</a></li>)}
      </ul>
      <div class="flex flex-wrap gap-3">
        <a href={site.orderUrl} target="_blank" rel="noopener" class="btn btn-ink">{c.hero.ctaOrder}</a>
        <a href={pathFor(c.nav.switchLang)} lang={c.nav.switchLang} class="btn btn-line" data-lang-switch>{c.nav.switchLabel}</a>
      </div>
    </nav>
  </div>
</header>
<style>
  .mobile-nav.is-open { display: block; }
  .nav-link { position: relative; transition: color 0.3s; }
  .nav-link::after { content: ''; position: absolute; inset-inline: 0; bottom: -6px; height: 1.5px; background: var(--color-cognac); scale: 0 1; transform-origin: left; transition: scale 0.5s var(--ease-pour); }
  .nav-link:hover::after { scale: 1 1; }
</style>
