---
import { site } from '../data/site';
import type { Content } from '../data/content';
import Button from './ui/Button.astro';
import SmartImage from './ui/SmartImage.astro';
import Doodle from './art/Doodle.astro';
interface Props { c: Content }
const { c } = Astro.props;
const h = c.hero;
const fx = c.fx;
---
<section id="hero" data-hero class="hero relative overflow-hidden pb-20 pt-32 md:pb-28 md:pt-40" aria-labelledby="hero-title">
  <div class="container-x grid items-end gap-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="t-meta flex flex-wrap items-center gap-x-3 gap-y-2 text-ink-soft" data-hero-fade>
        <span>{h.eyebrow}</span>
        <span class="status inline-flex items-center gap-2 rounded-full border-[1.5px] border-line px-3 py-1.5 text-ink" data-status-pill>
          <span class="dot h-2 w-2 rounded-full bg-cognac" aria-hidden="true"></span><span data-status></span>
        </span>
      </p>
      <h1 id="hero-title" class="t-display t-hero mt-8 text-ink">
        {h.title.split(' ').reduce((rows: string[][], w, i, arr) => { const per = Math.ceil(arr.length / 3); (rows[Math.floor(i / per)] ??= []).push(w); return rows; }, []).map((r) => (
          <span class="block overflow-hidden pb-[0.06em]"><span class="block" data-hero-line>{r.join(' ')}</span></span>
        ))}
      </h1>
      <div class="relative mt-8 max-w-xl" data-hero-fade>
        <p class="t-body text-ink-soft">{h.sub}</p>
        <p class="t-hand mt-6 inline-flex items-center gap-3 text-[2rem] text-cognac">
          <span>{fx.noteLead} <span class="rot" data-rotate={JSON.stringify(fx.rotate)} aria-live="off">{fx.rotate[0]}</span></span>
          <Doodle name="arrow" class="w-16 rtl:-scale-x-100" />
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-3" data-hero-fade>
        <Button href="#menu" label={h.ctaMenu} />
        <Button href={site.orderUrl} label={h.ctaOrder} variant="line" external arrow={false} />
      </div>
    </div>
    <div class="relative lg:col-span-5" data-hero-fade>
      <div class="relative ms-auto aspect-[4/5] w-[86%] overflow-hidden rounded-[999px_999px_28px_28px]" data-depth="14" data-tilt="6" data-tag={h.eyebrow}>
        <div class="h-full w-full" data-drift><SmartImage name="hero-latte" alt="" sizes="(min-width: 1024px) 34vw, 80vw" priority doodle="cup" /></div>
      </div>
      <div data-depth="-26" class="absolute -bottom-14 -start-4 aspect-square w-[34%] overflow-hidden rounded-[28px] border-[6px] border-milk shadow-[0_20px_40px_-24px_rgba(28,26,23,0.35)]">
        <SmartImage name="hero-room" alt="" sizes="(min-width: 1024px) 16vw, 40vw" doodle="heart" tone="crema" />
      </div>
      <div class="absolute -top-10 end-0 w-20" data-depth="-40"><Doodle name="softserve" class="float-a w-full text-ink" /></div>
      <Doodle name="sparkle" class="absolute bottom-24 -end-2 w-7 text-cognac" />
    </div>
  </div>
  <p class="wm t-hand pointer-events-none absolute inset-x-0 -bottom-[0.18em] select-none text-center leading-none text-ink/[0.045]" aria-hidden="true" dir="ltr" data-wm>Lait</p>
</section>
<style>
  .status .dot { box-shadow: 0 0 0 0 rgb(176 90 38 / 0.5); animation: ping 2.2s infinite; }
  [data-open='false'] .dot { background: var(--color-ink-soft); animation: none; }
  @keyframes ping { 80%, 100% { box-shadow: 0 0 0 8px rgb(176 90 38 / 0); } }
  @media (prefers-reduced-motion: reduce) { .status .dot { animation: none; } }
</style>
