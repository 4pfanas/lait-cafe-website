---
// Hand-drawn marks in the spirit of the doodle on Lait's cups. `draw` makes them draw themselves on scroll.
interface Props { name: 'softserve' | 'cup' | 'croissant' | 'heart' | 'arrow' | 'circle' | 'sparkle' | 'beans' | 'box' | 'underline' | 'steam'; class?: string; draw?: boolean; label?: string }
const { name, class: cls = '', draw = true, label } = Astro.props;
const paths: Record<string, { vb: string; d: string[] }> = {
  softserve: { vb: '0 0 120 170', d: [
    'M38 92 L60 160 L82 92',
    'M34 92 Q60 98 86 92',
    'M46 106 L74 106 M50 120 L70 120 M54 134 L66 134',
    'M34 92 C22 88 24 72 38 72 C30 62 40 50 52 54 C50 40 66 32 74 44 C82 40 92 48 86 58 C98 62 98 78 86 82 C92 90 88 94 86 92',
    'M60 34 C58 26 64 20 66 14',
