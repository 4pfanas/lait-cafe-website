  steam: { vb: '0 0 60 80', d: ['M18 76 C6 60 30 50 18 34 C8 20 26 12 20 2', 'M40 76 C28 60 52 50 40 34 C30 20 48 12 42 2'] },
};
const p = paths[name];
---
<svg class:list={['doodle', draw && 'draw', cls]} viewBox={p.vb} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" data-draw={draw ? '' : undefined}>
  {p.d.map((d) => <path d={d} />)}
</svg>
