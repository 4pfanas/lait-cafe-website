---
// Scroll-driven 3D opening: milk pours into a Lait cup, a latte-art heart blooms, then the cup's milk fills the screen.
import type { Content } from '../data/content';
import Logo from './art/Logo.astro';
interface Props { c: Content }
const { c } = Astro.props;
const t = c.intro;
---
<section class="intro relative" aria-label={t.done} data-intro>
  <div class="sticky top-0 h-[100svh] overflow-hidden" data-intro-stage>
    <div class="intro-room absolute inset-0" aria-hidden="true"></div>
    <canvas class="absolute inset-0 h-full w-full" data-intro-canvas aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute inset-x-0 top-0 flex flex-col items-center px-5 pt-[13svh] text-center md:pt-[9svh]" data-intro-copy>
      <span class="text-[clamp(4.5rem,11vw,8rem)] text-ink"><Logo /></span>
      <p class="t-display mt-2 text-[clamp(1.6rem,3.4vw,2.6rem)] text-ink">{t.lines[0]} <span class="text-ink-soft">{t.lines[1]}</span></p>
    </div>
    <p class="t-hand pointer-events-none absolute bottom-[14svh] whitespace-nowrap start-1/2 -translate-x-1/2 text-[2rem] text-cognac opacity-0 rtl:translate-x-1/2" data-intro-done>{t.done}</p>
    <div class="pointer-events-none absolute inset-x-0 bottom-7 flex flex-col items-center gap-2 text-ink-soft" data-intro-hint>
      <span class="t-meta">{t.scroll}</span>
      <span class="intro-drop block h-9 w-px bg-ink/40" aria-hidden="true"></span>
    </div>
    <a href="#hero" class="t-meta absolute end-5 top-5 z-10 rounded-full border-[1.5px] border-line bg-milk/70 px-4 py-2 backdrop-blur hover:border-ink md:end-10 md:top-8" data-intro-skip>{t.skip} ↓</a>
    <div class="intro-milk pointer-events-none absolute inset-0" data-intro-milk aria-hidden="true"></div>
  </div>
</section>
<style>
  .intro { height: 320svh; }
  .intro-room { background: radial-gradient(70% 60% at 50% 62%, #fffdf8 0%, #f6f0e6 60%, #ece3d5 100%); }
  .intro-milk { background: var(--color-milk); opacity: 0; }
  .intro-drop { transform-origin: top; animation: drop 2.2s var(--ease-pour) infinite; }
  @keyframes drop { 0% { scale: 1 0; } 50% { scale: 1 1; transform-origin: top; } 51% { transform-origin: bottom; } 100% { scale: 1 0; transform-origin: bottom; } }
  :global(.intro-static) .intro { height: 0; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .intro-drop { animation: none; } }
</style>
